# App
# Leave blank for the shared developer/Infisical workflow. Set this only in
# your Git-ignored local env file to make `npm run dev` use that file.
# It is a local routing marker, not an access-control secret.
LOCAL_ENV_OWNER_KEY=
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./pipeline.db
# CORS origins allowed to submit preview-site forms. Leave empty to auto-build
# from PUBLIC_BASE_URL + localhost + 127.0.0.1 + *.vercel.app
# PREVIEW_ORIGIN_REGEX=
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated hostnames accepted by the API. Required in production.
# ALLOWED_HOSTS=leads.example.com

# Inbound webhook shared secret (generic inbound contract, P0)
INBOUND_WEBHOOK_SECRET=change_this_secret

# Operator auth (simple header token for P0 control plane)
ADMIN_TOKEN=change_this_token

# LLM providers (used only by bounded agents; deterministic path never requires them)
OPENAI_API_KEY=
# Set AI_PROVIDER=openrouter plus an OPENROUTER_API_KEY to use OpenRouter.
# Pin a non-free model for repeatable staging/CI; openrouter/free is for small
# local experiments only.
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=AI Lead Pipeline
CHAT_MODEL=gpt-4o-mini

# Hosting adapter (P0: Vercel-first, provider-replaceable)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_GITHUB_REPO_ID=
VERCEL_GIT_REF=main
# Optional: route multi-niche templates to their own Vercel projects. JSON map
# of template deploy_key (see config/templates) -> project. Unmapped templates
# fall back to VERCEL_PROJECT_ID above.
# Example: {"massage_spa":{"project_id":"prj_xxx","github_repo_id":"123","git_ref":"main"},"dental":{"project_id":"prj_yyy","github_repo_id":"456"}}
VERCEL_TEMPLATE_PROJECTS=

# Per-lead budget caps (EUR-equivalent units; work stops/downgrades before overspend)
PER_LEAD_TOKEN_BUDGET=0.25
# Hard output cap for every structured AI call.
AI_MAX_OUTPUT_TOKENS=600
# Bound each provider call; timeouts fall back deterministically and are logged.
AI_REQUEST_TIMEOUT_SECONDS=30
GOOGLE_PLACES_API_KEY=
CRAWL_MAX_PAGES=6
CRAWL_TIMEOUT_SECONDS=12
CRAWL_MAX_RESPONSE_BYTES=2000000
QA_ARTIFACT_DIR=./artifacts/preview_qa

# Background execution. Keep inline for local development and tests.
TASK_QUEUE_MODE=inline
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_DIR=./private_artifacts
ARTIFACT_RETENTION_DAYS=90
# Required when ARTIFACT_STORAGE_BACKEND=r2 (keep all values out of git).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=30
